{
    "experiment": "pythia14m-70m-mdpo-wikitext",
    "purpose": "Fixed full-batch inner updates with hard outer sync; initial dynamics pilot",
    "seed": 42,
    "data_seed": 20261008,
    "hydra_overrides": [
        "actor_rollout_ref.model.path={student_model}",
        "actor_rollout_ref.model.custom_chat_template=\"{% for message in messages %}{{ message['content'] }}{% endfor %}\"",
        "+actor_rollout_ref.model.override_config.attn_implementation=sdpa",
        "actor_rollout_ref.model.lora_rank=0",
        "actor_rollout_ref.actor.fsdp_config.model_dtype=bfloat16",
        "actor_rollout_ref.actor.optim.lr=1e-5",
        "actor_rollout_ref.actor.optim.weight_decay=0.0",
        "actor_rollout_ref.actor.ppo_mini_batch_size=16",
        "actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1",
        "actor_rollout_ref.actor.ppo_epochs=4",
        "actor_rollout_ref.actor.checkpoint.save_contents=[]",
        "actor_rollout_ref.rollout.max_model_len=128",
        "actor_rollout_ref.rollout.max_num_batched_tokens=2048",
        "actor_rollout_ref.rollout.max_num_seqs=16",
        "actor_rollout_ref.rollout.gpu_memory_utilization=0.25",
        "distillation.mirror_teacher_model_path={teacher_model}",
        "distillation.distillation_loss.mirror_eta=0.1",
        "distillation.distillation_loss.topk=16",
        "data.train_batch_size=16",
        "data.val_batch_size=16",
        "data.max_prompt_length=64",
        "data.max_response_length=64",
        "data.seed=42",
        "reward.custom_reward_function.path={reward_script}",
        "trainer.total_training_steps=32",
        "trainer.total_epochs=1",
        "trainer.save_freq=-1",
        "trainer.test_freq=-1",
        "trainer.default_local_dir={run_dir}/checkpoints",
        "trainer.log_val_generations=0",
        "trainer.max_actor_ckpt_to_keep=1",
        "trainer.project_name=mirror-opd-pythia",
        "trainer.experiment_name={run_name}",
        "trainer.logger=[console,file]",
        "+ray_kwargs.ray_init.runtime_env.env_vars.VERL_FILE_LOGGER_PATH={run_dir}/outer.jsonl"
    ]
}

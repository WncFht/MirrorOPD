{
    "experiment": "dapo-deepseek-4gpu",
    "purpose": "Shared 4-H800 configuration for 50 outer on-policy OPD, MDPO J16 and BPO J16 with full math suite",
    "hydra_overrides": [
        "actor_rollout_ref.model.path={student_model}",
        "actor_rollout_ref.model.custom_chat_template=null",
        "actor_rollout_ref.model.lora_rank=0",
        "actor_rollout_ref.model.enable_gradient_checkpointing=true",
        "actor_rollout_ref.actor.optim.lr=1e-6",
        "actor_rollout_ref.actor.optim.weight_decay=0.0",
        "actor_rollout_ref.actor.optim.clip_grad=2.0",
        "actor_rollout_ref.actor.grad_clip=2.0",
        "actor_rollout_ref.actor.fsdp_config.model_dtype=fp32",
        "actor_rollout_ref.actor.fsdp_config.param_offload=true",
        "actor_rollout_ref.ref.fsdp_config.param_offload=true",
        "actor_rollout_ref.actor.ppo_mini_batch_size=64",
        "actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1",
        "actor_rollout_ref.actor.ppo_epochs=1",
        "actor_rollout_ref.actor.checkpoint.save_contents=[]",
        "actor_rollout_ref.rollout.max_model_len=9216",
        "actor_rollout_ref.rollout.max_num_batched_tokens=9216",
        "actor_rollout_ref.rollout.max_num_seqs=32",
        "actor_rollout_ref.rollout.gpu_memory_utilization=0.25",
        "actor_rollout_ref.rollout.val_kwargs.n=1",
        "actor_rollout_ref.rollout.val_kwargs.do_sample=false",
        "actor_rollout_ref.rollout.val_kwargs.temperature=0",
        "actor_rollout_ref.rollout.val_kwargs.top_p=1",
        "actor_rollout_ref.rollout.val_kwargs.top_k=-1",
        "distillation.mirror_teacher_model_path={teacher_model}",
        "distillation.distillation_loss.mirror_eta=0.3",
        "distillation.distillation_loss.topk=16",
        "data.train_batch_size=64",
        "data.val_batch_size=null",
        "data.max_prompt_length=2048",
        "data.max_response_length=7168",
        "data.truncation=error",
        "data.seed=42",
        "data.validation_shuffle=false",
        "reward.custom_reward_function.path={reward_script}",
        "trainer.total_training_steps=50",
        "trainer.total_epochs=1",
        "trainer.val_before_train=true",
        "trainer.test_freq=5",
        "trainer.save_freq=-1",
        "trainer.resume_mode=disable",
        "trainer.default_local_dir={run_dir}/checkpoints",
        "trainer.validation_data_dir=null",
        "trainer.rollout_data_dir=null",
        "trainer.log_val_generations=0",
        "trainer.project_name=mirror-opd-dapo-math-4gpu",
        "trainer.experiment_name={run_name}",
        "+ray_kwargs.ray_init.runtime_env.env_vars.VERL_FILE_LOGGER_PATH={run_dir}/outer.jsonl",
        "actor_rollout_ref.model.use_remove_padding=true",
        "trainer.n_gpus_per_node=4",
        "ray_kwargs.ray_init.num_cpus=24",
        "+ray_kwargs.ray_init.address=local",
        "+ray_kwargs.ray_init.num_gpus=4",
        "actor_rollout_ref.actor.use_dynamic_bsz=false",
        "actor_rollout_ref.ref.log_prob_micro_batch_size_per_gpu=1",
        "actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=1",
        "distillation.distillation_loss.use_task_rewards=false",
        "distillation.distillation_loss.use_policy_gradient=false",
        "actor_rollout_ref.ref.log_prob_use_dynamic_bsz=false",
        "actor_rollout_ref.rollout.log_prob_use_dynamic_bsz=false",
        "+actor_rollout_ref.actor.fsdp_config.mixed_precision={param_dtype:bf16,reduce_dtype:fp32,buffer_dtype:fp32}",
        "+actor_rollout_ref.ref.fsdp_config.mixed_precision={param_dtype:bf16,reduce_dtype:fp32,buffer_dtype:fp32}",
        "+ray_kwargs.ray_init.include_dashboard=false"
    ]
}

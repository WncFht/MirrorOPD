  "test_program": "\"\"\"Read-only CPU audit of the current cache and loss implementation.\"\"\"\nimport hashlib\nimport json\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nimport pytest\nimport torch\n\nimport mirroropd.core.cache as cache_module\nfrom mirroropd.core.cache import build_cache\nfrom mirroropd.core.config import CacheContext, Estimator, Objective\nfrom mirroropd.core.distributions import Distribution\nfrom mirroropd.core.objectives import compute_loss\n\nROOT = Path(__file__).resolve().parents[3]\nROWS = []\n\n\ndef tensor_bytes(values):\n    return sum(v.numel() * v.element_size() for v in values.values())\n\n\n@pytest.mark.parametrize('algorithm', ['on_policy', 'mdpo', 'bpo'])\n@pytest.mark.parametrize(('center', 'integration'), [('topj_tail', 'sampled'), ('full', 'sampled'), ('full', 'full')])\ndef test_diagnostics_preserve_gradients_and_record_saved_tensors(algorithm, center, integration):\n    torch.manual_seed(812)\n    n, vocab = 8, 1024\n    q = torch.randn(n, vocab, dtype=torch.float64)\n    teacher = torch.randn_like(q)\n    actions = torch.randint(vocab, (n,))\n    base = Objective(algorithm, estimator=Estimator(center, integration, 16))\n    context = CacheContext(0, 'fixed-teacher', 'fixed-vocabulary', vocab, 1., base.signal, base.estimator)\n    frozen = build_cache(q, teacher, actions, torch.ones(n, dtype=torch.bool), context)\n    initial = q if algorithm == 'on_policy' else q + .12 * torch.randn_like(q)\n    gradients = []\n    for level in ['none', 'basic', 'full']:\n        objective = replace(base, diagnostics=level)\n        z = initial.clone().requires_grad_()\n        saved = []\n        calls = []\n        original = Distribution.from_logits\n        def traced(logits, **kwargs):\n            calls.append({'shape':list(logits.shape), 'materialize':kwargs.get('materialize', False), 'grad_enabled':torch.is_grad_enabled()})\n            return original(logits, **kwargs)\n        def pack(tensor):\n            saved.append({'shape':list(tensor.shape), 'dtype':str(tensor.dtype), 'storage':tensor.untyped_storage().data_ptr(), 'storage_bytes':tensor.untyped_storage().nbytes()})\n            return tensor\n        with patch.object(Distribution, 'from_logits', side_effect=traced), torch.autograd.graph.saved_tensors_hooks(pack, lambda tensor:tensor):\n            result = compute_loss(z, frozen, objective, anchor_version=0)\n            result.loss.mean().backward()\n        gradients.append(z.grad.clone())\n        unique = {row['storage']:row['storage_bytes'] for row in saved}\n        ROWS.append({'kind':'loss', 'algorithm':algorithm, 'center':center, 'integration':integration, 'diagnostics':level, 'n':n, 'vocab':vocab, 'dtype':'float64', 'cache_bytes':tensor_bytes(frozen.tensors()), 'saved_unique_storage_bytes':sum(unique.values()), 'saved_tensor_count':len(saved), 'distribution_calls':calls, 'large_saved_shapes':[r['shape'] for r in saved if r['shape']==[n,vocab]]})\n    for gradient in gradients[1:]:\n        torch.testing.assert_close(gradient, gradients[0], atol=3e-15, rtol=3e-12)\n\n\n@pytest.mark.parametrize(('center', 'integration'), [('topj_tail', 'sampled'), ('full', 'sampled'), ('full', 'full')])\ndef test_full_cache_stores_dense_sequence_slots(center, integration):\n    torch.manual_seed(813)\n    q = torch.randn(2, 12, 128)\n    teacher = torch.randn_like(q)\n    actions = torch.randint(128, (2,12))\n    valid = torch.zeros(2,12,dtype=torch.bool)\n    valid[:,8:10] = True\n    obj = Objective('bpo', estimator=Estimator(center,integration,8))\n    context = CacheContext(0,'teacher','vocabulary',128,1.,obj.signal,obj.estimator)\n    frozen = build_cache(q,teacher,actions,valid,context)\n    fields = {key:{'shape':list(value.shape),'bytes':value.numel()*value.element_size()} for key,value in frozen.tensors().items()}\n    if center=='full':\n        assert fields['anchor_full']['bytes']==2*12*128*4\n        assert fields['anchor_full']['bytes']==6*int(valid.sum())*128*4\n    ROWS.append({'kind':'layout','center':center,'integration':integration,'valid_prefixes':int(valid.sum()),'sequence_slots':valid.numel(),'dtype':'float32','cache_bytes':tensor_bytes(frozen.tensors()),'fields':fields})\n\n\ndef test_sampled_mdpo_without_diagnostics_still_builds_unused_center():\n    torch.manual_seed(814)\n    q=torch.randn(4,128)\n    teacher=torch.randn_like(q)\n    obj=Objective('mdpo', diagnostics='none')\n    context=CacheContext(0,'teacher','vocabulary',128,1.,obj.signal,obj.estimator)\n    original=cache_module.power_reward\n    seen=[]\n    def record(value,signal):\n        seen.append(list(value.shape))\n        return original(value,signal)\n    with patch.object(cache_module,'power_reward',side_effect=record):\n        frozen=build_cache(q,teacher,torch.arange(4),torch.ones(4,dtype=torch.bool),context,diagnostics='none')\n    assert seen and frozen.reward_center is not None\n    ROWS.append({'kind':'unused_center_work','algorithm':'mdpo','diagnostics':'none','reward_input_shapes_during_cache':seen,'cache_bytes':tensor_bytes(frozen.tensors())})\n\n\n\ndef test_full_bpo_can_eliminate_student_log_normalizer():\n    torch.manual_seed(815)\n    qlog=torch.randn(3,17,dtype=torch.float64).log_softmax(-1)\n    target=torch.randn(3,17,dtype=torch.float64).log_softmax(-1)\n    q=qlog.exp()\n    maximum=0.0\n    for shift in [0.,10000.,-10000.]:\n        z=(torch.randn_like(qlog)+shift).requires_grad_()\n        logp=z.log_softmax(-1)\n        residual=logp-target\n        residual=residual-(q*residual).sum(-1,keepdim=True)\n        original=(q*residual.square()).sum(-1)/.4\n        raw=z-target\n        raw=raw-(q*raw).sum(-1,keepdim=True)\n        proposed=(q*raw.square()).sum(-1)/.4\n        g1=torch.autograd.grad(original.sum(),z,retain_graph=True)[0]\n        g2=torch.autograd.grad(proposed.sum(),z)[0]\n        torch.testing.assert_close(original,proposed,atol=2e-10,rtol=2e-11)\n        torch.testing.assert_close(g1,g2,atol=2e-11,rtol=2e-11)\n        maximum=max(maximum,float((g1-g2).abs().max()))\n    ROWS.append({'kind':'full_bpo_raw_logit_identity','dtype':'float64','shifts':[0.,10000.,-10000.],'max_gradient_difference':maximum,'scope':'Exact normalized anchor weights; direct full BPO only. Does not validate sampled substitution or a fused GPU kernel.'})\n\ndef test_serialize_audit_results():\n    assert len(ROWS)==32\n    manifest=json.loads((Path(__file__).parent/'source-manifest.json').read_text())\n    changed=[]\n    for item in manifest['files']:\n        digest=hashlib.sha256((ROOT/item['path']).read_bytes()).hexdigest()\n        if item['path'].startswith('src/mirroropd/core/'):\n            assert digest==item['sha256'], item['path']\n        elif digest!=item['sha256']:\n            changed.append({'path':item['path'],'initial_sha256':item['sha256'],'observed_sha256':digest})\n    benchmark=json.loads((ROOT/'results/refactor-20261015/kernel-benchmark.json').read_text())\n    historical=[r for r in benchmark['cases'] if r['prefixes']==56 and r['algorithm']=='bpo' and r['center']=='topj_tail' and r['integration']=='sampled']\n    summary={'scope':'CPU allocation-layout, saved-storage and exact gradient parity audit; no GPU peak or throughput measurement', 'torch':torch.__version__,'seed':[812,813,814],'source_manifest':manifest,'changed_non_core_files':changed,'test_program':Path(__file__).read_text(),'records':ROWS,'historical_gpu_scope':benchmark['metadata'],'historical_gpu_bpo_56':historical}\n    output=ROOT/'results/framework-memory-review-20261015/cpu-audit.json'\n    output.parent.mkdir(parents=True,exist_ok=True)\n    output.write_text(json.dumps(summary,ensure_ascii=False,indent=2)+'\\n')\n",

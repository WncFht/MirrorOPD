+def build_mirror_anchor_cache(
+    anchor_logits: torch.Tensor,
+    actions: torch.Tensor,
+    valid: torch.Tensor,
+    topk: int,
+) -> dict[str, torch.Tensor]:
+    """Anchor-worker output: O(prefixes * topk), with no full logits transfer.
+
+    Logits already include the rollout temperature. The worker can release
+    them before a separate teacher forward, retaining this frozen cache only.
+    """
+    if anchor_logits.ndim < 2:
+        raise ValueError("anchor logits must have (..., vocab) shape")
+    if actions.shape != anchor_logits.shape[:-1] or valid.shape != actions.shape:
+        raise ValueError("actions and valid must align with prediction positions")
+    vocab = anchor_logits.shape[-1]
+    if not 0 <= topk <= vocab:
+        raise ValueError(f"topk must lie in [0, {vocab}]")
+    valid = valid.bool()
+    safe_actions = torch.where(valid, actions, torch.zeros_like(actions))
+    anchor_logp = torch.log_softmax(anchor_logits.detach().float().masked_fill(~valid.unsqueeze(-1), 0), dim=-1)
+    anchor_ids = anchor_logp.topk(topk, dim=-1).indices
+    anchor_head = anchor_logp.gather(-1, anchor_ids).detach()
+    outside = torch.ones_like(anchor_logp, dtype=torch.bool)
+    outside.scatter_(-1, anchor_ids, False)
+    anchor_tail = anchor_logp.masked_fill(~outside, float("-inf")).logsumexp(-1)
+    anchor_action = anchor_logp.gather(-1, safe_actions.unsqueeze(-1)).squeeze(-1)
+    result = {
+        "mirror_valid": valid.bool(),
+        "mirror_actions": actions,
+        "mirror_anchor_ids": anchor_ids,
+        "mirror_anchor_head_log_probs": anchor_head,
+        "mirror_anchor_tail_log_prob": anchor_tail,
+        "mirror_anchor_action_log_prob": anchor_action.detach(),
+        "mirror_vocab_size": torch.full_like(actions, vocab),
+    }
+    # Do not allow invalid prompt/terminal locations to leak arbitrary cache
+    # values into diagnostics; loss adapter still masks them before gather.
+    for key, value in result.items():
+        if key == "mirror_valid":
+            continue
+        result[key] = torch.where(
+            valid.unsqueeze(-1) if value.ndim == valid.ndim + 1 else valid, value, torch.zeros_like(value)
+        )
+    return result
+
+
+def complete_mirror_teacher_cache(
+    teacher_logits: torch.Tensor,
+    anchor_cache: dict[str, torch.Tensor],
+) -> dict[str, torch.Tensor]:
+    """Score anchor-selected ids locally and return compact frozen fields.
+
+    The teacher must share the anchor's tokenizer and vocabulary semantics.
+    Native teacher top-k results cannot substitute for these requested ids.
+    """
+    valid = anchor_cache["mirror_valid"].bool()
+    actions = anchor_cache["mirror_actions"]
+    ids = anchor_cache["mirror_anchor_ids"]
+    qhead = anchor_cache["mirror_anchor_head_log_probs"].detach().float()
+    qtail = anchor_cache["mirror_anchor_tail_log_prob"].detach().float()
+    if teacher_logits.shape[:-1] != valid.shape or actions.shape != valid.shape:
+        raise ValueError("teacher logits and anchor cache must align with prediction positions")
+    if ids.shape != qhead.shape or ids.shape[:-1] != valid.shape or qtail.shape != valid.shape:
+        raise ValueError("anchor head and tail shapes must align with prediction positions")
+    vocab = teacher_logits.shape[-1]
+    if ids.shape[-1] > vocab:
+        raise ValueError("anchor support is larger than the teacher vocabulary")
+    if ((anchor_cache["mirror_vocab_size"] != vocab) & valid).any():
+        raise ValueError("anchor and teacher vocabulary sizes must match")
+    teacher_logp = torch.log_softmax(teacher_logits.detach().float().masked_fill(~valid.unsqueeze(-1), 0), dim=-1)
+    teacher_head = teacher_logp.gather(-1, ids)
+    outside = torch.ones_like(teacher_logp, dtype=torch.bool)
+    outside.scatter_(-1, ids, False)
+    teacher_tail = teacher_logp.masked_fill(~outside, float("-inf")).logsumexp(-1)
+    center = (qhead.exp() * (qhead - teacher_head)).sum(-1)
+    nonempty = torch.isfinite(qtail) & valid
+    tail = torch.zeros_like(center)
+    tail[nonempty] = qtail[nonempty].exp() * (qtail[nonempty] - teacher_tail[nonempty])
+    center = center + tail
+    safe_actions = torch.where(valid, actions, torch.zeros_like(actions))
+    action_lp = teacher_logp.gather(-1, safe_actions.unsqueeze(-1)).squeeze(-1)
+    result = dict(anchor_cache)
+    result.pop("mirror_vocab_size")
+    result["mirror_teacher_action_log_prob"] = torch.where(valid, action_lp, 0).detach()
+    result["mirror_teacher_center"] = torch.where(valid, center, 0).detach()
+    return result
+
+
+def build_mirror_opd_cache_from_full_logits(
+    anchor_logits: torch.Tensor,
+    teacher_logits: torch.Tensor,
+    actions: torch.Tensor,
+    valid: torch.Tensor,
+    topk: int,
+) -> dict[str, torch.Tensor]:
+    """Full-logit oracle for the sequential compact worker cache contract."""
+    if anchor_logits.shape != teacher_logits.shape:
+        raise ValueError("anchor and teacher logits must have identical (..., vocab) shape")
+    anchor_cache = build_mirror_anchor_cache(anchor_logits, actions, valid, topk)
+    return complete_mirror_teacher_cache(teacher_logits, anchor_cache)
+
+
+def compute_mirror_cache_from_logits(student_logits, data, stage, topk=None):
+    """Compact cache scoring for a no-padding, full-vocabulary inference pass.
+
+    The engine supplies temperature-scaled logits of shape (total_tokens, V).
+    Cache fields remain prediction-position aligned; they are not rolled here.
+    """
+    if get_ulysses_sequence_parallel_world_size() != 1:
+        raise NotImplementedError("MirrorOPD cache scoring requires sequence parallel size 1")
+    if student_logits.ndim != 2:
+        raise ValueError("cache inference expects (total_tokens, vocab) logits")
+
+    def values(key):
+        tensor = data[key]
+        return tensor.values() if tensor.is_nested else tensor
+
+    if stage == "anchor":
+        if topk is None:
+            raise ValueError("anchor cache inference requires mirror_cache_topk")
+        return build_mirror_anchor_cache(
+            student_logits, values("mirror_actions"), values("mirror_valid"), topk
+        )
+    if stage == "teacher":
+        cache = {key: values(key) for key in (
+            "mirror_valid", "mirror_actions", "mirror_anchor_ids",
+            "mirror_anchor_head_log_probs", "mirror_anchor_tail_log_prob",
+            "mirror_anchor_action_log_prob", "mirror_vocab_size",
+        )}
+        completed = complete_mirror_teacher_cache(student_logits, cache)
+        return {key: completed[key] for key in (
+            "mirror_teacher_action_log_prob", "mirror_teacher_center",
+        )}
+    raise ValueError(f"unknown mirror_cache_stage: {stage}")
+
+
+def compute_mirror_opd_token_loss(
+    student_logits: torch.Tensor,
+    actions: torch.Tensor,
+    anchor_ids: torch.Tensor,
+    anchor_head_log_probs: torch.Tensor,
+    anchor_tail_log_prob: torch.Tensor,
+    anchor_action_log_prob: torch.Tensor,
+    teacher_action_log_prob: torch.Tensor,
+    teacher_center: torch.Tensor,
+    method: str,
+    eta: float,
+) -> dict[str, torch.Tensor]:
+    """Token score surrogate on frozen anchor actions (no PPO clipping).
+
+    Logits must already have the rollout temperature applied. All cache
+    tensors refer to the same prefix and tokenizer. The anchor support stays
+    fixed throughout inner updates. Unlike TA-OPD's direct KL loss, centers
+    and residuals here stop gradient after deriving the score formula.
+    This primitive operates on a local complete vocabulary, not TP shards.
+    """
+    if eta <= 0 or method not in ("pmd_mean", "bpo", "mdpo"):
+        raise ValueError("positive eta and a supported MirrorOPD method required")
+    expected = student_logits.shape[:-1]
+    if any(
+        t.shape != expected
+        for t in (actions, anchor_tail_log_prob, anchor_action_log_prob, teacher_action_log_prob, teacher_center)
+    ):
+        raise ValueError("all scalar cache fields must align with prefix dimensions")
+    if anchor_ids.shape != anchor_head_log_probs.shape or anchor_ids.shape[:-1] != expected:
+        raise ValueError("anchor head ids/log-probs must align with prefixes")
+    log_p = torch.log_softmax(student_logits.float(), dim=-1)
+    action_lp = log_p.gather(-1, actions.unsqueeze(-1)).squeeze(-1)
+    with torch.no_grad():
+        q_head = anchor_head_log_probs.detach().float()
+        p_head = log_p.detach().gather(-1, anchor_ids)
+        head = (q_head.exp() * (q_head - p_head)).sum(-1)
+        outside = torch.ones_like(log_p, dtype=torch.bool)
+        outside.scatter_(-1, anchor_ids, False)
+        p_tail_lp = torch.logsumexp(log_p.detach().masked_fill(~outside, float("-inf")), -1)
+        q_tail_lp = anchor_tail_log_prob.detach().float()
+        tail = torch.zeros_like(head)
+        nonempty = torch.isfinite(q_tail_lp)
+        tail[nonempty] = q_tail_lp[nonempty].exp() * (q_tail_lp[nonempty] - p_tail_lp[nonempty])
+        center = head + tail
+        u = action_lp.detach() - anchor_action_log_prob.detach()
+        reward = teacher_action_log_prob.detach() - anchor_action_log_prob.detach()
+        kt = teacher_center.detach()
+        if method == "pmd_mean":
+            coefficient = u - eta * (reward + kt)
+        elif method == "bpo":
+            coefficient = (u + center) / eta - reward - kt
+        else:
+            coefficient = (u / eta - reward) * u.exp()
+        if not torch.isfinite(coefficient).all():
+            raise FloatingPointError("nonfinite MirrorOPD weight; no silent ratio clipping")
+    return {
+        "distillation_losses": coefficient * action_lp,
+        "mirror_student_center": center,
+        "mirror_teacher_center": teacher_center.detach(),
+        "mirror_importance_ratio": u.exp() if method == "mdpo" else torch.ones_like(u),
+    }
+
+
+def compute_mirror_opd_from_cache(student_logits, data, config, data_format):
+    """Consume prediction-position-aligned caches after engine unpadding.
+
+    Cache producers must put response token t at its predecessor position.
+    Prompt and terminal positions have mirror_valid=False and are excluded
+    before any probability arithmetic. Sequence parallel is not enabled yet.
+    """
+    if get_ulysses_sequence_parallel_world_size() != 1:
+        raise NotImplementedError("MirrorOPD cache adapter requires sequence parallel size 1")
+    if data_format not in ("thd", "bshd"):
+        raise ValueError("unsupported MirrorOPD data format")
+    fields = (
+        "mirror_valid",
+        "mirror_actions",
+        "mirror_anchor_ids",
+        "mirror_anchor_head_log_probs",
+        "mirror_anchor_tail_log_prob",
+        "mirror_anchor_action_log_prob",
+        "mirror_teacher_action_log_prob",
+        "mirror_teacher_center",
+    )
+    cache = {}
+    for key in fields:
+        value = data[key]
+        value = value.values().unsqueeze(0) if value.is_nested else value
+        if value.shape[:2] != student_logits.shape[:2]:
+            raise ValueError(f"{key} must align with full prediction positions")
+        cache[key] = value
+    valid = cache["mirror_valid"].bool()
+    result = {
+        key: student_logits.new_zeros(valid.shape, dtype=torch.float32)
+        for key in ("distillation_losses", "mirror_student_center", "mirror_teacher_center", "mirror_importance_ratio")
+    }
+    if valid.any():
+        outputs = compute_mirror_opd_token_loss(
+            student_logits=student_logits[valid],
+            actions=cache["mirror_actions"][valid],
+            anchor_ids=cache["mirror_anchor_ids"][valid],
+            anchor_head_log_probs=cache["mirror_anchor_head_log_probs"][valid],
+            anchor_tail_log_prob=cache["mirror_anchor_tail_log_prob"][valid],
+            anchor_action_log_prob=cache["mirror_anchor_action_log_prob"][valid],
+            teacher_action_log_prob=cache["mirror_teacher_action_log_prob"][valid],
+            teacher_center=cache["mirror_teacher_center"][valid],
+            method=config.distillation_loss.loss_mode.removeprefix("mirror_"),
+            eta=config.distillation_loss.mirror_eta,
+        )
+        for key, value in outputs.items():
+            result[key][valid] = value
+    else:
+        result["distillation_losses"] = student_logits.sum(-1) * 0
+    return result
+

@@ -32,6 +32,113 @@ def kl_divergence(log_q: torch.Tensor, log_p: torch.Tensor) -> torch.Tensor:
     return kld.sum(dim=-1)
 
 
+def compute_mirror_opd_token_loss(
+    student_logits: torch.Tensor,
+    actions: torch.Tensor,
+    anchor_ids: torch.Tensor,
+    anchor_head_log_probs: torch.Tensor,
+    anchor_tail_log_prob: torch.Tensor,
+    anchor_action_log_prob: torch.Tensor,
+    teacher_action_log_prob: torch.Tensor,
+    teacher_center: torch.Tensor,
+    method: str,
+    eta: float,
+) -> dict[str, torch.Tensor]:
+    """Token score surrogate on frozen anchor actions (no PPO clipping).
+
+    Logits must already have the rollout temperature applied. All cache
+    tensors refer to the same prefix and tokenizer. The anchor support stays
+    fixed throughout inner updates. Unlike TA-OPD's direct KL loss, centers
+    and residuals here stop gradient after deriving the score formula.
+    This primitive operates on a local complete vocabulary, not TP shards.
+    """
+    if eta <= 0 or method not in ("pmd_mean", "bpo", "mdpo"):
+        raise ValueError("positive eta and a supported MirrorOPD method required")
+    expected = student_logits.shape[:-1]
+    if any(t.shape != expected for t in (actions, anchor_tail_log_prob,
+            anchor_action_log_prob, teacher_action_log_prob, teacher_center)):
+        raise ValueError("all scalar cache fields must align with prefix dimensions")
+    if anchor_ids.shape != anchor_head_log_probs.shape or anchor_ids.shape[:-1] != expected:
+        raise ValueError("anchor head ids/log-probs must align with prefixes")
+    log_p = torch.log_softmax(student_logits.float(), dim=-1)
+    action_lp = log_p.gather(-1, actions.unsqueeze(-1)).squeeze(-1)
+    with torch.no_grad():
+        q_head = anchor_head_log_probs.detach().float()
+        p_head = log_p.detach().gather(-1, anchor_ids)
+        head = (q_head.exp() * (q_head - p_head)).sum(-1)
+        outside = torch.ones_like(log_p, dtype=torch.bool)
+        outside.scatter_(-1, anchor_ids, False)
+        p_tail_lp = torch.logsumexp(log_p.detach().masked_fill(~outside, float("-inf")), -1)
+        q_tail_lp = anchor_tail_log_prob.detach().float()
+        tail = torch.zeros_like(head)
+        nonempty = torch.isfinite(q_tail_lp)
+        tail[nonempty] = q_tail_lp[nonempty].exp() * (q_tail_lp[nonempty] - p_tail_lp[nonempty])
+        center = head + tail
+        u = action_lp.detach() - anchor_action_log_prob.detach()
+        reward = teacher_action_log_prob.detach() - anchor_action_log_prob.detach()
+        kt = teacher_center.detach()
+        if method == "pmd_mean":
+            coefficient = u - eta * (reward + kt)
+        elif method == "bpo":
+            coefficient = (u + center) / eta - reward - kt
+        else:
+            coefficient = (u / eta - reward) * u.exp()
+        if not torch.isfinite(coefficient).all():
+            raise FloatingPointError("nonfinite MirrorOPD weight; no silent ratio clipping")
+    return {"distillation_losses": coefficient * action_lp,
+            "mirror_student_center": center,
+            "mirror_teacher_center": teacher_center.detach(),
+            "mirror_importance_ratio": u.exp() if method == "mdpo" else torch.ones_like(u)}
+
+
+def compute_mirror_opd_from_cache(student_logits, data, config, data_format):
+    """Consume prediction-position-aligned caches after engine unpadding.
+
+    Cache producers must put response token t at its predecessor position.
+    Prompt and terminal positions have mirror_valid=False and are excluded
+    before any probability arithmetic. Sequence parallel is not enabled yet.
+    """
+    if get_ulysses_sequence_parallel_world_size() != 1:
+        raise NotImplementedError("MirrorOPD cache adapter requires sequence parallel size 1")
+    if data_format not in ("thd", "bshd"):
+        raise ValueError("unsupported MirrorOPD data format")
+    fields = (
+        "mirror_valid", "mirror_actions", "mirror_anchor_ids",
+        "mirror_anchor_head_log_probs", "mirror_anchor_tail_log_prob",
+        "mirror_anchor_action_log_prob", "mirror_teacher_action_log_prob",
+        "mirror_teacher_center",
+    )
+    cache = {}
+    for key in fields:
+        value = data[key]
+        value = value.values().unsqueeze(0) if value.is_nested else value
+        if value.shape[:2] != student_logits.shape[:2]:
+            raise ValueError(f"{key} must align with full prediction positions")
+        cache[key] = value
+    valid = cache["mirror_valid"].bool()
+    result = {key: student_logits.new_zeros(valid.shape, dtype=torch.float32)
+              for key in ("distillation_losses", "mirror_student_center",
+                          "mirror_teacher_center", "mirror_importance_ratio")}
+    if valid.any():
+        outputs = compute_mirror_opd_token_loss(
+            student_logits=student_logits[valid],
+            actions=cache["mirror_actions"][valid],
+            anchor_ids=cache["mirror_anchor_ids"][valid],
+            anchor_head_log_probs=cache["mirror_anchor_head_log_probs"][valid],
+            anchor_tail_log_prob=cache["mirror_anchor_tail_log_prob"][valid],
+            anchor_action_log_prob=cache["mirror_anchor_action_log_prob"][valid],
+            teacher_action_log_prob=cache["mirror_teacher_action_log_prob"][valid],
+            teacher_center=cache["mirror_teacher_center"][valid],
+            method=config.distillation_loss.loss_mode.removeprefix("mirror_"),
+            eta=config.distillation_loss.mirror_eta,
+        )
+        for key, value in outputs.items():
+            result[key][valid] = value
+    else:
+        result["distillation_losses"] = student_logits.sum(-1) * 0
+    return result
+
+

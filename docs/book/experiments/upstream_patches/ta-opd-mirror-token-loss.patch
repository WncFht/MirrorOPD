+def build_mirror_prediction_fields(data: TensorDict) -> dict[str, torch.Tensor]:
+    """Align sampled response actions to their preceding logit positions.
+
+    Prompts are left padded and responses right padded. The response mask can
+    exclude tokens, while the attention mask determines real sequence tokens.
+    """
+    ids = data["input_ids"]
+    attention = data["attention_mask"].bool()
+    response_mask = data["response_mask"].bool()
+    if ids.ndim != 2 or attention.shape != ids.shape or response_mask.ndim != 2:
+        raise ValueError("MirrorOPD requires padded 2D input ids and masks")
+    if response_mask.shape[0] != ids.shape[0] or response_mask.shape[1] >= ids.shape[1]:
+        raise ValueError("MirrorOPD requires a nonempty prompt before response tokens")
+    action_mask = torch.zeros_like(attention)
+    action_mask[:, -response_mask.shape[1]:] = response_mask
+    valid = torch.zeros_like(attention)
+    valid[:, :-1] = action_mask[:, 1:] & attention[:, :-1] & attention[:, 1:]
+    actions = torch.where(valid, ids.roll(-1, dims=1), 0)
+    return {"mirror_valid": valid, "mirror_actions": actions}
+

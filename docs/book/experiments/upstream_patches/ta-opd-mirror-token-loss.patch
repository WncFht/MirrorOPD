+def no_padding_2_full_padding(tensor: torch.Tensor, data: TensorDict) -> torch.Tensor:
+    """Restore complete prediction-position arrays, preserving head dimensions.
+
+    This differs from response-only slicing: no one-token shift is applied,
+    because cache actions have already been aligned to predictor positions.
+    """
+    values = tensor.values() if tensor.is_nested else tensor
+    mask = data["attention_mask"]
+    indices = tu.get_non_tensor_data(data, key="indices")
+    if values.shape[0] != indices.numel():
+        raise ValueError("cache output token count differs from unpadding indices")
+    indices = indices.to(values.device)
+    padded = values.new_zeros((mask.numel(), *values.shape[1:]))
+    padded.index_copy_(0, indices, values)
+    return padded.reshape(*mask.shape, *values.shape[1:])

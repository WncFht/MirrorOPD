{
    "private": true,
    "scripts": {
        "format": "prettier --write \"**/*.{md,yaml,yml,json,jsonc}\"",
        "format:check": "prettier --check \"**/*.{md,yaml,yml,json,jsonc}\"",
        "lint:md": "markdownlint-cli2 \"**/*.md\"",
        "lint:python": "ruff check .",
        "lint:shell": "python3 scripts/check_shell.py",
        "lint": "npm run lint:md && npm run lint:python && npm run lint:shell && python3 scripts/check-yaml-comments.py && actionlint",
        "setup:links": "bash scripts/agent-links.sh && bash scripts/crossnote-links.sh",
        "test:preview": "node --test assets/.crossnote/tests/*.test.cjs",
        "check": "python3 scripts/run_checks.py --config scripts/checks.json --mode ci"
    },
    "devDependencies": {
        "git-format-staged": "4.0.2",
        "markdownlint-cli2": "0.23.3",
        "prettier": "3.9.6",
        "playwright": "1.64.1",
        "quickjs-emscripten": "0.32.0"
    },
    "overrides": {
        "smol-toml": "1.9.1",
        "js-yaml": "5.4.3",
        "markdown-it": "15.0.2",
        "katex": "0.19.0"
    },
    "name": "mirroropd"
}
